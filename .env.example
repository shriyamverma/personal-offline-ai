# Copy to .env and fill these values locally. Never commit .env or put keys in VITE_* variables.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
CHAT_MODEL=openai/gpt-oss-20b
GROQ_CHAT_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b

# Use the cluster URL and a cluster data API key, not a Qdrant account-management token.
# Enable Cloud Inference in the cluster settings.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=shriyam_ai_memory_minilm_v1
